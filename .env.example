# Скопіюйте у .env (cp .env.example .env) і змініть значення. Файл .env НЕ комітиться.

# --- Порт, що публікується на хості ---
FRONTEND_PORT=8080

# --- PostgreSQL ---
DB_USER=bookswap
DB_PASSWORD=change_me_db_password
DB_NAME=bookswap

# --- Backend ---
JWT_SECRET=change_me_long_random_secret
JWT_TTL=2h
CATALOG_CACHE_TTL=60

# --- S3-сумісне сховище (MinIO локально) ---
S3_ACCESS_KEY=bookswap_minio
S3_SECRET_KEY=change_me_minio_secret
S3_BUCKET=book-covers
